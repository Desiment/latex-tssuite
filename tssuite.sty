% LTeX: enabled=false
% ==============================================================================
% TEXT SUITE PACKAGE (tssuite)
% A LaTeX package for typography enhancements, shortcuts, and theorem management
% ==============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tssuite}[2026/01/01 Typography and text utilities package]

% ==============================================================================
% DEPENDENCIES
% ==============================================================================

\RequirePackage{stackengine}
\RequirePackage{multicol}
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage{xparse}
\RequirePackage{iftex}

\ifLuaTeX
  \RequirePackage{lua-widow-control}
\fi

% ==============================================================================
% LISTS CONFIGURATION
% ==============================================================================

\input{code/tssuite.lists.code.tex}

% ==============================================================================
% PACKAGE OPTIONS
% ==============================================================================

\RequirePackage{kvoptions}

\SetupKeyvalOptions{
  family=tssuite,
  prefix=@tssuite@,
}

\DeclareBoolOption[false]{shortcuts}
\DeclareBoolOption[false]{draft}
\DeclareBoolOption[false]{theorems}
\DeclareBoolOption[false]{framedtheorems}

\newif\if@tssuite@todoextensionset
\newcommand*{\@tssuite@todoextension}{5cm}

\define@key{tssuite}{todoextension}{%
  \@tssuite@todoextensionsettrue
  \renewcommand*{\@tssuite@todoextension}{#1}%
}

\ProcessKeyvalOptions{tssuite}

% framedtheorems implies theorems
\if@tssuite@framedtheorems
  \@tssuite@theoremstrue
\fi

% todoextension requires draft
\if@tssuite@todoextensionset
  \if@tssuite@draft
  \else
    \PackageError{tssuite}
      {Option 'todoextension' requires option 'draft'}
      {The 'todoextension' option can only be used together with 'draft'.^^J%
       Add the 'draft' option or remove 'todoextension'.}
  \fi
\fi

% ==============================================================================
% MEMOIZE FORWARD DECLARATIONS
% ==============================================================================
% Empty stubs for \tssuite_memoize_disable: / \tssuite_memoize_enable: that
% are always defined. They are redefined in code/tssuite.theorems.code.tex
% when framedtheorems and the memoize package are both loaded.
% ==============================================================================

\ExplSyntaxOn

\cs_new_protected:Npn\tssuite_memoize_disable:{}
\cs_new_protected:Npn\tssuite_memoize_enable:{}

\ExplSyntaxOff

% ==============================================================================
% TEXT FIELDS
% ==============================================================================

\input{code/tssuite.fields.code.tex}

% ==============================================================================
% SHORTCUT COMMANDS
% ==============================================================================

\if@tssuite@shortcuts
  \input{code/tssuite.shorthands.code.tex}
\fi

% ==============================================================================
% TODO NOTES
% ==============================================================================

\if@tssuite@draft
  \RequirePackage{todonotes}
  \input{code/tssuite.draft.code.tex}
\else
  \RequirePackage[disable]{todonotes}
\fi

% ==============================================================================
% THEOREM ENVIRONMENTS
% ==============================================================================

\if@tssuite@theorems
  \RequirePackage{amsthm}
  \RequirePackage{keytheorems}
  \if@tssuite@framedtheorems
    \RequirePackage{mdframed}
    \RequirePackage{tikz}
    \RequirePackage{pgf}
  \fi
  \input{code/tssuite.theorems.code.tex}
\fi

\endinput
